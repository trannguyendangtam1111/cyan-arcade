# Settings for docker compose. Copy to .env and change what you need; every value here is the default.

# Database
DB_NAME=cyan_arcade
DB_USERNAME=cyan
DB_PASSWORD=cyan
# Host port of PostgreSQL (5433 so it can run next to a local PostgreSQL on 5432).
DB_PORT=5433

# Backend
BACKEND_PORT=8080
# true wherever the site is served over HTTPS, so the session cookie is only sent over HTTPS.
SESSION_COOKIE_SECURE=false
# Origins allowed to call the API directly from a browser, comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public POST request budgets per client IP (separate from failed-login throttling).
REGISTRATION_MAX_REQUESTS=5
REGISTRATION_REQUEST_WINDOW=1h
LOGIN_MAX_REQUESTS=30
LOGIN_REQUEST_WINDOW=1m
GAME_SESSION_MAX_REQUESTS=60
GAME_SESSION_REQUEST_WINDOW=1m
# Forwarding is opt-in. Before using native, set an exact pattern for the real proxy peer IP(s)
# seen by the backend and keep the backend private. (?!) trusts no address.
SERVER_FORWARD_HEADERS_STRATEGY=none
TRUSTED_PROXY_REGEX=(?!)
# Card packs a player may open per day (UTC). 0 means no limit.
TCG_DAILY_PACK_LIMIT=10
# Optional admin account (AI mode, unlimited packs). To create one, set this to true and fill in
# both credentials. No default password. Existing accounts and passwords are never changed.
ADMIN_SEED_ENABLED=false
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Stockfish, the chess engine (built into the backend image). Engine processes at most, search
# threads and hash memory (MB) per process, move hints per game for players (admins: no limit), and
# engine requests one account may make per minute.
STOCKFISH_POOL_SIZE=2
STOCKFISH_THREADS=1
STOCKFISH_HASH_MB=32
CHESS_HINTS_PER_GAME=3
CHESS_ENGINE_REQUESTS_PER_MINUTE=30

# Frontend
FRONTEND_PORT=3000
